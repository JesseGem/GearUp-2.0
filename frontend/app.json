{
  "expo": {
    "name": "gearup-mobile",
    "slug": "gearup-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/GearUp-Icon.png",
    "backgroundColor": "#0B1220",
    "primaryColor": "#0B1220",
    "userInterfaceStyle": "light",
    "scheme": "gearup",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GearUp needs your location to connect you with nearby mechanics.",
        "NSLocationAlwaysUsageDescription": "GearUp needs your location to connect you with nearby mechanics."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/GearUp-Icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.alfred.quist.gearupmobile"
    },
    "web": {
      "favicon": "./assets/GearUp-Icon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "GearUp needs your location to connect you with nearby mechanics."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "GearUp needs access to your photos so you can add pictures of your parts listings."
        }
      ],
      "expo-audio",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1220",
          "image": "./assets/GearUp-Logo.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b31cf0e4-ddc3-460b-9378-f8f0cf48cd8f"
      }
    }
  }
}
